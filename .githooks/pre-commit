#!/usr/bin/env bash
set -euo pipefail
# pre-commit — three refusals, cheapest first.
#
# Running a check and gating on it are different things. On 2026-09-02 three
# commits went out having failed check-docs, because the check reported and the
# commit happened anyway.

REPO="$(git rev-parse --show-toplevel)"
# The application's own facts (the registers, its format step) are its technical
# profile's, asked through board-profile.py (#485).
BOARD="$(cd "$(dirname "$0")/.." && pwd)/scripts/programme/board"
PROFILE="$BOARD/board-profile.py"

# run_board <script> <args...> < input: runs one of the board commands this hook
# asks, leaving its stdout in BOARD_OUT and its status in BOARD_RC.
#
# **Exit 70 is not an answer.** These commands answer in their exit status (0
# yes, 1 no) and a hook that reads any non-zero status as "no" lets every rule
# below pass when the profile they read is missing or lacks a key (the loader
# exits 70 then, `profile.EXIT_PROFILE_ERROR`). So on 70 the commit is refused,
# with the loader's message. Any other status is the command's answer or a
# failure this hook has always tolerated.
run_board() {
  local err
  err="$(mktemp)"
  BOARD_RC=0
  BOARD_OUT="$(python3 "$BOARD/$1" "${@:2}" 2>"$err")" || BOARD_RC=$?
  if [ "$BOARD_RC" -eq 70 ]; then
    {
      echo "commit refused: the profile the rules read cannot be used."
      echo
      sed 's/^/  /' "$err"
      echo
      echo "  Every rule below asks the technical profile (programme.toml) or the"
      echo "  programme file; with neither, none of them can say yes or no."
    } >&2
    rm -f "$err"
    exit 1
  fi
  rm -f "$err"
}
STAGED="$(git diff --cached --name-only --diff-filter=ACMR || true)"
BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
MERGING=0
[ -e "$(git rev-parse --git-dir)/MERGE_HEAD" ] && MERGING=1

# --- 1. an image change on `main` needs a branch ------------------------------
#
# **What ships in the image goes through a branch and a pull request.** Documents
# and scripts are live when they are pushed and need neither; the image is what
# production runs.
#
# The rule is inverted on purpose: it lists what does **not** ship, and refuses
# everything else. Listing what does ship means a build asset nobody thought of
# — a new compose file, a config the Dockerfile starts copying — is missed in
# silence. This way an unrecognised path is refused, which is noisy and visible
# and fixed by adding one line here.
#
# The exclusions are about what reaches the binary, not about what looks like
# code. `include_str!` compiles data in as surely as source, so a data file under
# the source tree ships and is refused; the application's test suite says so by
# name. Markdown is allowed anywhere, because nothing `include_str!`s a `.md`:
# the day something does, that line is the reason it passed, and it should stop
# being true rather than be worked around. A crate's `examples`, `tests` and
# `benches` are excluded because they are not built into the image; the
# exclusion holds only while examples stay demonstration and measurement code,
# and anything generating a file the binary `include_str!`s is a crate instead
# (#306). The Dockerfile `COPY`s a legacy crate folder into the build context, so
# changing it changes the image that gets built, and the manifest is not
# excluded even though it carries dev-dependencies: it decides what ships, and
# telling a dev dependency from a real one means parsing it. These entries are
# the technical profile's `ships.non_shipping`, with the reason for each.
#
# Measured over 140 commits on `main`, the old form fired once — 0b18a66f, which
# changed the Caddyfile and docker-compose.yml directly on main during #240.
# Squash merges are made by GitHub and never reach this hook; a local merge is
# skipped.
# The pattern lives in scripts/shipping-paths.sh, sourced here and by deploy.sh,
# which marks the same commits in its build manifest (#288). Two copies is how
# the same defect comes to exist in two places, and this one decides both
# whether a commit is refused and whether a release is described correctly.
#
# Located relative to **this hook**, not to the repository being committed to.
# The two ship together, and `git rev-parse --show-toplevel` points at whatever
# repo is being committed in — which is the hook's own repo in normal use and a
# fixture's temporary one under test.
# shellcheck source=../scripts/shipping-paths.sh
. "$(cd "$(dirname "$0")/.." && pwd)/scripts/shipping-paths.sh"

# The one image change that belongs on `main`: the post-deploy version bump.
#
# `deploy.sh` writes it immediately after a successful production deploy, and
# `CLAUDE.md` requires it — *"bump dev to the next patch straight after each
# production deploy; dev leads production by one"*. It cannot take a branch,
# because a branch holds a change back (§2.2) and this one records a version
# that is **already live**. So the rule above has an exception that is generated
# rather than authored, and #316 is the release where the two collided: 0.7.2
# deployed, tagged and published, then failed on its own last step.
#
# Recognised rather than trusted. Two conditions, both required:
#
#   - the staged set is exactly the profile's `versions.bump.required` files,
#     optionally with the rest of `versions.bump.files`
#   - every changed line in them matches `versions.bump.line`
#
# So a dependency added to the manifest, a lockfile that pulls a new crate, or
# a bump with a source file alongside it are all still refused. The
# exemption cannot be widened by adding a file to the commit, which is the
# property that makes it safe to have at all.
#
# `<<<` and not a pipe into `grep -q`: grep exits on its first match, the
# writer takes SIGPIPE, and under `pipefail` the pipeline reports 141 — so the
# test would silently invert. That defect has already cost this project a
# production deploy; see scripts/issue-mentions.sh.
# **The rule is the model's**, `scripts/programme/board/shipping.py`'s `version_bump_only`
# (#421), asked through `board-shipping.py` rather than held here.
version_bump_only() {
  run_board board-shipping.py version-bump --staged </dev/null
  [ "$BOARD_RC" -eq 0 ]
}

if [ "$MERGING" -eq 0 ] && [ "$BRANCH" = "main" ]; then
  run_board board-shipping.py paths <<< "$STAGED"
  IMAGE="$BOARD_OUT"
  if [ -n "$IMAGE" ] && version_bump_only; then
    IMAGE=""
  fi
  if [ -n "$IMAGE" ]; then
    {
      echo "commit refused: this changes what ships in the image, on main."
      echo
      printf '  %s\n' $IMAGE
      echo
      echo "  An image change goes through a branch and a pull request — it is what"
      echo "  production runs. Documents, scripts, tests and examples are live when"
      echo "  pushed and need neither."
      echo
      echo "  git switch -c <issue>-<name> and commit there, or --no-verify with"
      echo "  the reason in the message."
      echo
      echo "  If one of those genuinely does not ship, add it to ships.non_shipping in"
      echo "  the technical profile (programme.toml) and say why."
    } >&2
    exit 1
  fi
fi

# --- 1b. the programme's own documents live on main ---------------------------
#
# **The mirror of section 1, and it is the direction that has no gate.** Section
# 1 stops an image change reaching `main` without a pull request. Nothing stopped
# the reverse: work that belongs on `main` being committed to whatever branch
# happened to be checked out.
#
# `commit-msg` catches most of it, by refusing a message that names an issue the
# branch is not for. **Its hole is a commit with no trailer at all**, which it
# assumes belongs to the branch -- and process edits are exactly that shape,
# because they record a rule rather than serving an issue. On 2026-09-21 the
# ITIL rule, a CLAUDE.md clause and an obligations.py fix were all written onto
# `399-database-failure-status` while #399's own change sat committed beneath
# them. Caught by reading `git status`, which is not a gate.
#
# **These files are the programme, and the programme is not a project.** A
# programme document describes the programme and how it operates; an
# application document describes the application. Most of them are in the
# programme repository now (#485); what is staged here is the pin of its
# submodule, `programme`, the instruction files and the roadmap. The
# technical ones change with the code, on the project branch. The process ones belong to no project, so they change on
# `main`: a copy on a branch disagrees with `main` until it merges, and makes the
# process wait on a project it has nothing to do with (owner, 2026-09-25).
#
# **docs/4.1.5 and docs/4.1.6 are neither, because they are generated.** It is the map of the
# headings on whichever branch it is built from, so a branch that adds headings
# needs its own. Regenerated after the rebase that precedes a merge (docs/4.3.3
# §1.9), it is exactly the map `main` will have once the branch fast-forwards.
#
# **A project may still change them**, when it is the project that changes the
# process, or when the document rides its release. So this refuses and offers
# `--no-verify`, in the same shape as the check above it -- it is asking *did
# you mean this*, not forbidding it.
#
# **The list is the model's**, `scripts/programme/board/documents.py` (#421), asked
# through `board-documents.py` rather than held here.

if [ "$MERGING" -eq 0 ] && [ "$BRANCH" != "main" ]; then
  run_board board-documents.py programme <<< "$STAGED"
  ONMAIN="$BOARD_OUT"
  if [ -n "$ONMAIN" ]; then
    {
      echo "commit refused: the programme's own documents belong on main, not $BRANCH."
      echo
      printf '  %s\n' $ONMAIN
      echo
      echo "  A document saying how we work is true for every branch at once, so a"
      echo "  copy on one branch disagrees with main until it merges. commit-msg"
      echo "  cannot catch this: a programme edit carries no Refs, and a commit with"
      echo "  no trailer is assumed to belong to the branch."
      echo
      echo "  git stash push -u, switch to main, apply there — or --no-verify if"
      echo "  this project is the one changing the programme, and say so."
    } >&2
    exit 1
  fi
fi

# --- 1c. the application's documents usually ride their change's branch -------
#
# **The mirror of 1b, and it warns rather than refuses** (owner, 2026-09-30:
# "warn, but not block. I want to keep some flexibility"). An application
# document describes the application, so it usually changes on the branch of
# the change it describes, typically the same branch as the code (#421 R5). A
# correction to one on its own is fine on `main`, which is why this only says
# so. Not during a merge: a branch landing on `main` brings its documents with
# it, and that is the rule working.

if [ "$MERGING" -eq 0 ] && [ "$BRANCH" = "main" ]; then
  run_board board-documents.py application <<< "$STAGED"
  APPDOCS="$BOARD_OUT"
  if [ -n "$APPDOCS" ]; then
    {
      echo "note: application documents committed to main:"
      echo
      printf '  %s\n' $APPDOCS
      echo
      echo "  These usually ride the branch of the change they describe. A"
      echo "  correction on its own is fine here; committing anyway."
    } >&2
  fi
fi

# --- 2. a new artefact is registered ------------------------------------------
#
# **Something permanent needs somewhere to be found.** Not an issue — the owner,
# 2026-09-03: a quick edit should not need a requirement. A row in the register
# is the whole obligation.
#
# Five artefacts were created on 2-3 September and two were unregistered, both
# within an hour of this being written.
# `.claude/*.sh` is here because tooling is an artefact whether it runs in
# production or not (owner, 2026-09-03). Those two hooks were outside the
# repository and outside this rule until then, which is how turn-check.sh came
# to be filtering comments on a marker that nothing had written for weeks.
NEW="$(printf '%s\n' "$STAGED" | grep -E '^(scripts/[^/]+\.(sh|py)$|\.githooks/[^/]+$|\.claude/([^/]+\.sh$|skills/[^/]+/))' || true)"
# Below the top of scripts/, where the model's library modules sit beside the
# commands since the folders (#421), a script is a file the index marks
# executable. Whether library modules should register too is not decided here.
EXECUTABLE="$(git ls-files -s -- scripts | awk -F'\t' '$1 ~ /^100755 / && $2 ~ /^scripts\/.+\// { print $2 }')"
BELOW="$(printf '%s\n' "$STAGED" | grep -E '^scripts/.+/' | grep -Fx -f <(printf '%s\n' "$EXECUTABLE") || true)"
NEW="$(printf '%s\n%s\n' "$NEW" "$BELOW" | grep -v '^$' || true)"
if [ -n "$NEW" ]; then
  UNREGISTERED=""
  REGISTERS=()
  if REGISTER_LIST="$(python3 "$PROFILE" -C "$REPO" registers)"; then
    while IFS= read -r register; do REGISTERS+=("$REPO/$register"); done <<< "$REGISTER_LIST"
  else
    echo "commit refused: the registers cannot be read from the technical profile." >&2
    exit 1
  fi
  while read -r f; do
    [ -n "$f" ] || continue
    case "$f" in */tests/*) continue ;; esac
    # a file already tracked is not new
    git ls-tree -r --name-only HEAD -- "$f" 2>/dev/null | grep -qx "$f" && continue
    name="$(basename "$f")"
    case "$f" in .claude/skills/*) name="$(printf '%s' "$f" | cut -d/ -f3)" ;; esac
    # Two registers since 2026-09-30: the application's tooling (technical
    # profile, `documents.tools_registers`) and the programme's (in the pinned
    # submodule, the programme file's `programme_documents.tools_register`).
    # A name in either is registered.
    grep -qF "$name" "${REGISTERS[@]}" 2>/dev/null || UNREGISTERED="$UNREGISTERED $f"
  done <<< "$NEW"
  if [ -n "$UNREGISTERED" ]; then
    {
      echo "commit refused: a new artefact is not in the register."
      echo
      printf '  %s\n' $UNREGISTERED
      echo
      echo "  Add a row saying what it is and what runs it, to the register for the"
      echo "  application's tooling or the programme's:"
      printf '    %s\n' "${REGISTERS[@]#"$REPO"/}"
      echo "  A row, not an issue."
    } >&2
    exit 1
  fi
fi

# --- 3. the application's own format step ------------------------------------
#
# What the application formats, and with what, is its technical profile's
# `hooks.pre_commit` (#485). Tile Lite Elite's is rustfmt, run only when a `.rs`
# file is staged: 535 ms, so a commit touching no Rust does not pay for it.
#
# CI's format check ran red on `main` for fourteen commits on 2026-09-04 before
# anybody looked. Nothing local checked formatting, `cargo clippy` does not, and
# the breakage was two `println!` calls over the line width in an example — the
# cheapest possible defect, costing a day of red CI and a release gate that
# would have refused every one of those commits.
#
# The step's command exits non-zero and writes a diff without touching the tree
# (`--check`), so a refusal here never rewrites what is about to be committed.
# `requires_file` is not decoration: without it the step would run in any
# repository that happens to contain a staged `.rs` file, and cargo exits
# non-zero outside a project — refusing the commit for a reason that has nothing
# to do with formatting.
if ! STEPS="$(python3 "$PROFILE" -C "$REPO" get hooks.pre_commit)"; then
  echo "commit refused: the pre-commit steps cannot be read from the technical profile." >&2
  exit 1
fi
# Each step is a block of `name=value` lines and an empty line (board-profile.py),
# read by name, so key order and an empty value cannot shift one into another.
step_name="" step_staged="" step_file="" step_tool="" step_command="" step_refusal="" step_fix=""
run_step() {
  [ -n "$step_name$step_staged$step_file$step_tool$step_command$step_refusal$step_fix" ] || return 0
  if [ -z "$step_name" ] || [ -z "$step_staged" ] || [ -z "$step_command" ]; then
    echo "commit refused: a hooks.pre_commit step in the technical profile lacks its name, staged or command." >&2
    exit 1
  fi
  if printf '%s\n' "$STAGED" | grep -qE "$step_staged" \
     && { [ -z "$step_file" ] || [ -f "$REPO/$step_file" ]; } \
     && { [ -z "$step_tool" ] || command -v "$step_tool" > /dev/null; }; then
    if ! step_out="$(cd "$REPO" && bash -c "$step_command" 2>&1)"; then
      {
        echo "commit refused: $step_refusal"
        echo
        # The files a formatter names (`Diff in <path>`), shown from the
        # repository's root; the tool's own words when it names none.
        shown="$(printf '%s\n' "$step_out" | grep '^Diff in' \
          | awk -v p="$REPO/" '{ i = index($0, p); print "  " (i ? substr($0, i + length(p)) : $0) }' | sort -u || true)"
        printf '%s\n' "${shown:-$step_out}"
        echo
        echo "  $step_fix"
      } >&2
      exit 1
    fi
  fi
  step_name="" step_staged="" step_file="" step_tool="" step_command="" step_refusal="" step_fix=""
}
while IFS= read -r line; do
  case "$line" in
    name=*) step_name="${line#name=}" ;;
    staged=*) step_staged="${line#staged=}" ;;
    requires_file=*) step_file="${line#requires_file=}" ;;
    requires_command=*) step_tool="${line#requires_command=}" ;;
    command=*) step_command="${line#command=}" ;;
    refusal=*) step_refusal="${line#refusal=}" ;;
    fix=*) step_fix="${line#fix=}" ;;
    "") run_step ;;
  esac
done <<< "$STEPS"
run_step

# --- 4. the documentation checks ----------------------------------------------
#
# The only conditional one: it reads every markdown file and takes a few
# seconds, so a commit touching no documents does not pay for it. A check that
# makes every commit slower is one people bypass.
if printf '%s\n' "$STAGED" | grep -qE '\.md$' && [ -x "$REPO/scripts/programme/docs/check-docs.sh" ]; then
  if ! output="$("$REPO/scripts/programme/docs/check-docs.sh" 2>&1)"; then
    printf '%s\n' "$output" >&2
    cat >&2 <<'MSG'

pre-commit: the documentation checks failed, so nothing was committed.

Fix what is reported above, or commit with --no-verify if you are certain —
worth explaining in the commit message, because the next person will wonder.
MSG
    exit 1
  fi
fi
