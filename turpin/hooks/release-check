#!/usr/bin/env bash
# release-check (laptop): is this version the right kind for what its milestone
# holds? Runs check-release-version.sh, which exits 1 for a patch carrying
# functional change and 2 where it cannot judge; either refuses. Turpin runs this
# hook from a scratch export of turpin/hooks, with the repository as the working
# directory, so the repository is found from there, not from this file. Under
# CHECK_RELEASE_STRICT=1 the script refuses where it cannot read the milestone
# (no `gh`, GitHub's answer an error) instead of passing. Design 545 §2.2.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

need TURPIN_VERSION
root="$(git rev-parse --show-toplevel 2> /dev/null)" \
  || die "$PWD is not in a git repository, so it cannot find check-release-version.sh"
[[ -x "$root/scripts/deliver/check-release-version.sh" ]] \
  || die "$root/scripts/deliver/check-release-version.sh is missing, so it cannot judge the version"
(cd "$root" && CHECK_RELEASE_STRICT=1 ./scripts/deliver/check-release-version.sh "$TURPIN_VERSION") >&2 \
  || die "check-release-version.sh refused $TURPIN_VERSION"
