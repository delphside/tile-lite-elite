#!/usr/bin/env bash
# restore-state (host): replaces the data volume's contents from
# `turpin-$TURPIN_DEPLOY.tgz`, and does nothing where there is none, since then
# save-state never finished and nothing changed the data. The server is stopped
# and left stopped (Turpin starts it). Safe to run again. Each Docker call is
# within 120 s (design 545 §2.2.2).
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

need TURPIN_DEPLOY TURPIN_IMAGE_SERVER
dir="$(snapshot_dir)"
name="turpin-$TURPIN_DEPLOY.tgz"

if [[ ! -f "$dir/$name" ]]; then
  echo "restore-state: no $dir/$name, so nothing to restore" >&2
  exit 0
fi

for container in $(server_containers 120); do
  bounded 120 docker stop "$container" > /dev/null
done

# Clear the volume before unpacking rather than untarring over the top.
bounded 120 docker run --rm \
  -v "$(tle_volume):/data" -v "$dir:/snapshots:ro" \
  --entrypoint sh "$TURPIN_IMAGE_SERVER" \
  -c "rm -rf /data/* /data/.[!.]* 2>/dev/null; tar xzf /snapshots/$name -C /data" \
  || die "could not restore $(tle_volume) from $dir/$name"
echo "restore-state: $(tle_volume) restored from $dir/$name" >&2
