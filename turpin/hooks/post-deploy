#!/usr/bin/env bash
# post-deploy (laptop): the public /health reports this version, and after
# production the `Release Check` issues now waiting are listed. A check, not a
# gate (Turpin's design §9): the second part reports and never refuses. Where the
# address does not report the version yet it says not yet (75), since DNS and
# caches can lag a deploy that has already passed. Rehearsal has no address in
# the profile, so it is read from scripts/deliver/rehearsal-target.sh (below).
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

need TURPIN_VERSION TURPIN_SHA
# Rehearsal's profile gives no address of its own: REHEARSAL_URL where it is set
# (the profile's `[environments.rehearsal].env`), otherwise the way the profile's
# `url_from` reads it, from the repository (the working directory), in a
# subshell. Only rehearsal, and only where Turpin gave no address.
if [[ "${TURPIN_ENV:-}" == rehearsal && -z "${TURPIN_URL:-}" ]]; then
  TURPIN_URL="${REHEARSAL_URL:-}"
  if [[ -z "$TURPIN_URL" && -f "$PWD/scripts/deliver/rehearsal-target.sh" ]]; then
    TURPIN_URL="$(source "$PWD/scripts/deliver/rehearsal-target.sh" > /dev/null 2>&1 && printf '%s' "${TARGET_URL:-}")" || TURPIN_URL=""
  fi
fi
need TURPIN_URL

body="$(curl -sf --max-time 10 "${TURPIN_URL%/}/health" 2> /dev/null || true)"
got="$(printf '%s' "$body" | app_version_of)"
if ! version_ok "$got"; then
  echo "post-deploy: ${TURPIN_URL%/}/health reports '${got:-nothing}', not $TURPIN_VERSION+${TURPIN_SHA:0:7}" >&2
  exit 75
fi
echo "post-deploy: ${TURPIN_URL%/}/health reports $got" >&2

if [[ "${TURPIN_ENV:-}" == production ]]; then
  listing="$(gh issue list --label "Release Check" --state open \
    --json number,title --jq '.[] | "  #\(.number)  \(.title)"' 2> /dev/null || true)"
  if [[ -n "$listing" ]]; then
    {
      echo "These were waiting for a release to check against; now they can be:"
      printf '%s\n' "$listing"
      echo "Answer each in its issue, then take the label off."
    } >&2
  fi
fi
