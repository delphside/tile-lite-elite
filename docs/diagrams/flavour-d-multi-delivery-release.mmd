---
config:
  layout: elk
  elk:
    nodePlacementStrategy: BRANDES_KOEPF
---
flowchart TB
    %% Flavour D — a release carrying several deliveries. docs/3.3, the
    %% flavours table: 1.1 and 1.2 per delivery, then 1.8.1 to merge each in,
    %% 1.8 to sync, then 1.3, 1.4, 1.5, 1.9, 1.6, 1.7, 1.10.
    %% .
    %% The only difference from C is where the gathering happens. One
    %% delivery fast-forwards main directly; several are gathered on a
    %% release branch first and the branch tip is what is proved. Everything
    %% from 1.3 onwards is identical to C.
    %% .
    %% 1.8.1 is a gate, not a merge command: merge-to-release.sh judges the
    %% incoming pull request's run AND the release branch's current tip, and
    %% a missing run refuses. What it reads is in its own label rather than
    %% drawn as an arrow from Actions: that edge pulled the gate down beside
    %% Actions, and its merge into the release branch then wrapped the whole
    %% diagram to climb back. That is the point of the flavour — each
    %% delivery joins a branch that is known green, rather than several
    %% arriving on main and being sorted out afterwards.
    %% .
    %% 1.8 syncs with main LAST, immediately before rehearsing, so anything
    %% that landed on main while the release was being gathered is in what
    %% gets proved.
    %% .
    %% Two delivery branches are drawn because two is what makes the flavour
    %% different from C. Three or more add nothing to the picture.
    %% .
    %% Cutting the branch (1.8.0) and deleting it (1.10) are in the release
    %% branch's own label rather than drawn as arrows from main. Both are
    %% housekeeping at the ends of the flavour, and as edges they wrapped the
    %% whole diagram to reach a node that already sits below main.
    DEV["Dev<br/>working tree"]
    LG["local git<br/>commit history"]
    subgraph GH["GitHub"]
        MAIN["repo · main"]
        ACT["Actions"]
        BR1["delivery branch<br/>NNN-first"]
        BR2["delivery branch<br/>NNN-second"]
        REL["release branch<br/>release/X.Y.Z<br/>cut from main at 1.8.0,<br/>deleted at 1.10 with the rest"]
    end
    STG["Preview<br/>:8081 · docker"]
    REH["Rehearsal<br/>&lt;ip&gt;.sslip.io · docker"]
    PROD["Production<br/>tileliteelite.com"]

    DEV -->|"`1.1 · **$ cargo test**, **$ git commit**`"| LG
    LG -->|"`1.2 · **$ git push -u**, one branch per delivery`"| BR1
    LG -->|"1.2 · the same, for the second"| BR2
    BR1 -->|"1.2.2 · CI runs (automatic)"| ACT
    BR2 -->|"1.2.2 · CI runs (automatic)"| ACT
    BR1 -->|"`1.8.1 · **$ merge-to-release.sh**`"| MG{"gate<br/>the incoming run<br/>AND the branch tip,<br/>both green"}
    BR2 -->|"`1.8.1 · the same, for the second`"| MG
    MG -->|"merges each in"| REL
    MAIN -->|"`1.8 · **$ git merge** main, last`"| REL
    REL -->|"`1.3 · **$ deploy-preview.sh**`"| STG
    STG -.->|"`1.4 · **user test**`"| STG
    REL -->|"`1.5 · **$ deploy-rehearsal.sh**`"| REH
    REL -->|"`1.9 · **$ git merge --ff-only** the tip`"| MAIN
    MAIN -->|"`1.6.1 · **$ deploy.sh**`"| GATE{"gate"}
    ACT -.->|"1.6.2 · CI green for this commit?"| GATE
    REH -.->|"1.6.3 · rehearsal on this commit?"| GATE
    GATE -->|"1.6.4 · ships the image"| PROD
    PROD -.->|"`1.7 · **$ verify.sh**`"| PROD

    classDef gate fill:#fbe9dc,stroke:#b06a2c,color:#7a4318
    classDef env fill:#e4eff8,stroke:#39698c,color:#12303f
    classDef repo fill:#f7efe0,stroke:#96763f,color:#3a2c12
    classDef branch fill:#eef3ea,stroke:#5c7a4a,color:#243418
    class DEV,STG,REH,PROD env
    class LG,MAIN,ACT repo
    class BR1,BR2,REL branch
    class MG,GATE gate
    style GH fill:#fdf9f1,stroke:#96763f,color:#3a2c12
